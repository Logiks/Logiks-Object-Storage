PORT=8080
TMP_ROOT=/data/tmp
DB_PATH=/data/metadata.db
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_API_KEY=change-me
PRESIGN_SECRET=change-this-to-a-long-random-secret
MAX_OBJECT_SIZE=107374182400

# Which backend actually holds the object bytes: filesystem (default), s3,
# minio, azure, or sftp. Only the vars for the chosen backend are read; the
# others can be left unset. See README.md for details on each.
STORAGE_BACKEND=filesystem

# --- filesystem backend ---
STORAGE_ROOT=/data/objects

# --- s3 / minio backend ---
# MinIO is just S3 with a custom endpoint — use STORAGE_BACKEND=minio (or
# STORAGE_BACKEND=s3 with S3_FORCE_PATH_STYLE=true) and point S3_ENDPOINT at
# it. For real AWS S3, leave S3_ENDPOINT unset and set S3_REGION.
# S3_BUCKET=my-object-storage-bucket
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=

# --- azure backend ---
# Either set AZURE_STORAGE_CONNECTION_STRING, or both AZURE_STORAGE_ACCOUNT
# and AZURE_STORAGE_KEY.
# AZURE_CONTAINER=my-object-storage-container
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_PREFIX=

# --- sftp backend ---
# Either SFTP_PASSWORD or SFTP_PRIVATE_KEY (a path to a key file) is required.
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_PRIVATE_KEY=
# SFTP_PASSPHRASE=
# SFTP_BASE_PATH=/storage
