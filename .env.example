PORT=8080
TMP_ROOT=/data/tmp
DB_PATH=/data/metadata.db
PUBLIC_BASE_URL=http://localhost:8080
PRESIGN_SECRET=change-this-to-a-long-random-secret
MAX_OBJECT_SIZE=107374182400

# How long (ms) to wait for in-flight requests to finish on SIGTERM/SIGINT
# before forcing an exit, and how long /api/v1/health/ready waits for the
# backend to respond before reporting not-ready.
SHUTDOWN_TIMEOUT_MS=10000
READY_TIMEOUT_MS=5000

# --- Authentication ---
# Simplest case: a single key with full access to every bucket.
STORAGE_API_KEY=change-me
# For multiple keys and/or per-bucket scoping, set STORAGE_API_KEYS instead
# (it takes priority over STORAGE_API_KEY when set) — a JSON array where each
# entry is either a plain string (full access) or {"key","buckets":[...]}.
# A missing/empty "buckets" means unrestricted, same as a plain string.
# STORAGE_API_KEYS=[{"key":"admin-key"},{"key":"media-only-key","buckets":["media"]}]

# --- Optional hardening (all off by default) ---
# CORS: comma-separated allowed origins, or "*". Needed only if presigned
# URLs or the API will be fetched directly from browser JS.
# CORS_ORIGIN=https://example.com
# Basic per-IP rate limiting (a fixed window counter; not a substitute for a
# real reverse-proxy limiter under serious load). RATE_LIMIT_MAX=0 (or unset)
# disables it.
# RATE_LIMIT_MAX=0
# RATE_LIMIT_WINDOW_MS=60000
# Terminate TLS in this process instead of (or in addition to) a reverse
# proxy, by pointing these at a cert/key pair. Leave both unset for plain
# HTTP (the usual setup when a reverse proxy handles TLS).
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Which backend actually holds the object bytes: filesystem (default), s3,
# minio, azure, or sftp. Only the vars for the chosen backend are read; the
# others can be left unset. See README.md for details on each.
STORAGE_BACKEND=filesystem

# --- filesystem backend ---
STORAGE_ROOT=/data/objects

# --- s3 / minio backend ---
# MinIO is just S3 with a custom endpoint — use STORAGE_BACKEND=minio (or
# STORAGE_BACKEND=s3 with S3_FORCE_PATH_STYLE=true) and point S3_ENDPOINT at
# it. For real AWS S3, leave S3_ENDPOINT unset and set S3_REGION.
# S3_BUCKET=my-object-storage-bucket
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=

# --- azure backend ---
# Either set AZURE_STORAGE_CONNECTION_STRING, or both AZURE_STORAGE_ACCOUNT
# and AZURE_STORAGE_KEY.
# AZURE_CONTAINER=my-object-storage-container
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_PREFIX=

# --- sftp backend ---
# Either SFTP_PASSWORD or SFTP_PRIVATE_KEY (a path to a key file) is required.
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_PRIVATE_KEY=
# SFTP_PASSPHRASE=
# SFTP_BASE_PATH=/storage
